{
  "name": "amazshop",
  "version": "1.0.0",
  "description": "MERN shopping cart app",
  "type": "module",
  "scripts": {
    "start": "npm --prefix backend start",
    "server": "npm --prefix backend run dev",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "npm --prefix backend run data:import",
    "data:destroy": "npm --prefix backend run data:destroy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astle171/AmazShop.git"
  },
  "author": "Astle Machado",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Astle171/AmazShop/issues"
  },
  "homepage": "https://github.com/Astle171/AmazShop#readme",
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
